<link rel="preload" as="script" href="https://seg.ad.gt/api/v1/s/158" nonce="">
<script>window.fandomTrack = window.fandomTrack ?? { q: [], cmd: [] };
window.fandomTrack.q.push({
	event: 'trackingevent',
	payload: {
		event_type: 'yes_ads',
		ga_label: '',
		ga_category: 'yes_ads',
		ga_value: 4,
	},
});</script>
<script>	window.fandomAds = window.fandomAds || { cmd: [] };
	window.fandomAds.deploymentEnvironment = 'production';</script>
<script>window.fandomAgeGate = {
    banner: "closed",
    adultSelected: false,
    render: () => undefined,
    close: () => undefined,
};
window.dispatchEvent(new CustomEvent("fandomAgeGateUpdate"));</script>
<script src="https://accounts.google.com/gsi/intermediate" async></script>

<script>
	const useMaxDefaultContentWidth = Boolean(false);

	const defaultContentWidth = useMaxDefaultContentWidth ? 'expanded' : 'collapsed';

	let contentWidthPreference;

	try {
		contentWidthPreference = localStorage.getItem('contentwidth') || defaultContentWidth;
	} catch (e) {
		contentWidthPreference = defaultContentWidth;
	}

	if ( contentWidthPreference === 'expanded' ) {
		document.documentElement.classList.add('is-content-expanded');
